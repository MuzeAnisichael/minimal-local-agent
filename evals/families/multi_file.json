    {
      "id": "rename-external-conflict",
      "goal": "把配置项 TIMEOUT 改名为 REQUEST_TIMEOUT（期间有人改了 settings.py）",
      "files": {
        "settings.py": "TIMEOUT = 30\n",
        "client.py": "from settings import TIMEOUT\n\n\ndef fetch(session, url):\n    return session.get(url, timeout=TIMEOUT)\n"
      },
      "checks": [
        {
          "type": "file_contains",
          "path": "settings.py",
          "text": "REQUEST_TIMEOUT = 30"
        },
        {
          "type": "file_contains",
          "path": "client.py",
          "text": "timeout=REQUEST_TIMEOUT"
        }
      ],
      "fault": {
        "type": "external_edit",
        "path": "settings.py",
        "content": "TIMEOUT = 30\nRETRIES = 3\n"
      },
      "script": {
        "turns": [
          {
            "tool": "edit_files",
            "args": {
              "edits": [
                {
                  "path": "settings.py",
                  "old_text": "TIMEOUT = 30",
                  "new_text": "REQUEST_TIMEOUT = 30"
                },
                {
                  "path": "client.py",
                  "old_text": "import TIMEOUT",
                  "new_text": "import REQUEST_TIMEOUT"
                },
                {
                  "path": "client.py",
                  "old_text": "timeout=TIMEOUT",
                  "new_text": "timeout=REQUEST_TIMEOUT"
                }
              ]
            }
          },
          {
            "text": "已完成改名"
          },
          {
            "tool": "read_file",
            "args": {
              "path": "settings.py"
